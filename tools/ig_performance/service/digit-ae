#!/usr/bin/python3 -I
import os,sys,json,subprocess,math
BASE='/srv/digit-ae/admin/ig_performance_v1/'
a=sys.argv[1:]
is_ig=bool(a and a[0]=='performance') or '--action=performance' in a or any(x=='--action' and i+1<len(a) and a[i+1]=='performance' for i,x in enumerate(a))
if is_ig:os.execv('/usr/bin/python3',['/usr/bin/python3','-I','-B',BASE+'cli.py',*a])
if a and a[0]=='results' and '--json' not in a:
    r=subprocess.run(['/usr/bin/python3','-I','-B',BASE+'legacy_cli.py',*a,'--json'],text=True,capture_output=True)
    if not r.stdout.strip():sys.stderr.write(r.stderr);sys.exit(r.returncode)
    try:v=json.loads(r.stdout)
    except ValueError:sys.stderr.write(r.stderr or 'Invalid result response\n');sys.exit(1)
    print(' / '.join(a[1:3])+' | '+v['state']);ratios=[]
    if v['state'] in ('PASS','AUTHOR_REFERENCE','AE_REFERENCE'):
        s=v.get('summary',{})
        if 'points' in s:ratios=[('Best layout vs g2/r20',max(x['speedup_vs_fresh_g2_r20'] for x in s['points']))]
        elif 'arms' in s:ratios=[('DiGiT / GIDS',s['arms']['digit_full']['speedup_vs_gids'])]
        else:ratios=[(x['pair'],x.get('ratios',{}).get('training_speedup')) for x in v.get('results',[])]
        for label,value in ratios:
            if isinstance(value,(int,float)) and math.isfinite(value):print('%s: %.2fx'%(label,value))
    for k in ('error','output'):
        if v.get(k):print(k+': '+str(v[k]))
    sys.exit(r.returncode)
os.execv('/usr/bin/python3',['/usr/bin/python3','-I','-B',BASE+'legacy_cli.py',*a])
