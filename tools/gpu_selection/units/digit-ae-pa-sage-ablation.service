[Unit]
Description=DiGiT AE four-arm PA SAGE ablation
Requires=digit-ae-ablation-data.service
After=digit-ae-ablation-data.service
[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/home/embed/digit
ExecStart=/srv/digit-ae/env/bin/python -I -B -u /srv/digit-ae/admin/ablation_v1/controller.py
Environment=PYTHONDONTWRITEBYTECODE=1 CUDA_CACHE_DISABLE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Environment=LD_LIBRARY_PATH=/home/embed/digit/bam/build/lib
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONOPTIMIZE LD_PRELOAD
UMask=0022
KillMode=control-group
TimeoutStopSec=90
LimitMEMLOCK=infinity
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=no
BindReadOnlyPaths=/srv/digit-ae/releases/pa_sage_ablation_20260924_v1:/home/embed/digit
ReadOnlyPaths=/mnt
ReadWritePaths=/srv/digit-ae/ablation-results /srv/digit-ae/admin/ablation_v1/state /run/digit-ae-selfservice /tmp
StandardOutput=journal
StandardError=journal
